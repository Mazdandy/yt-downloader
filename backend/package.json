{
  "name": "video-downloader-backend",
  "version": "1.0.0",
  "description": "Multi-platform video downloader backend API (YouTube, TikTok, Instagram Reels)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm ci && tsc",
    "build:prod": "npm ci --include=dev && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "yt-dlp",
    "youtube",
    "tiktok",
    "instagram",
    "downloader"
  ],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
