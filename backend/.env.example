# Backend configuration (all optional)
PORT=8787
# Path to yt-dlp binary
YTDLP_PATH=yt-dlp
# Directory for temp download files (deleted after streaming)
# TEMP_DIR=/tmp

# Rate limiting (PRD §9.2 default: 30 req/hr/IP). Set RATE_LIMIT_MAX=0 to disable (dev only).
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MS=3600000

# Comma-separated CORS origins, or * for all
# CORS_ORIGINS=http://localhost:3000

# Max concurrent downloads (PRD FR-13 default: 3)
# MAX_CONCURRENT_DOWNLOADS=3
