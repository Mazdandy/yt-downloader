[Unit]
Description=LOTC - Video Downloader — frontend (Next.js, port 3000)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
# Same-origin API by default; for a split deploy set the backend URL here
# Environment=NEXT_PUBLIC_API_URL=https://api.yourdomain.com
ExecStart=/usr/bin/node __APP_DIR__/frontend/.next/standalone/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
