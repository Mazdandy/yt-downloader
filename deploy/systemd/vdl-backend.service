[Unit]
Description=Cloud Downloader — backend API (Express, port 8787)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__/backend
Environment=NODE_ENV=production
Environment=PORT=8787
# Temp downloads live here; adjust if you want a separate disk
Environment=TEMP_DIR=/tmp/vdl
ExecStart=/usr/bin/node __APP_DIR__/backend/dist/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
